{% extends 'base.html.twig' %}

{% block title 'Authors - Community Library' %}

{% block body %}
    <h1>Our collection ({{ authors|length }} authors)</h1>

    <div class="author-grid">
        {% for author in authors %}
        <div class="author-card">
            <h2>
                <a href="{{ path('app_author_show', {id: author.id}) }}">
                    {{ author.name }}
                </a>
            </h2>
            <p><em>{{ author.books|length }} book(s)</em></p>
        </div>
        {% endfor %}
    </div>
{% endblock body %}
