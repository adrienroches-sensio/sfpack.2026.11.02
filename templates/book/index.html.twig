{% extends 'base.html.twig' %}

{% block title %}Books — Community Library{% endblock %}

{% block body %}
    <h1>Our collection ({{ books|length }} books)</h1>

<div class="listing-layout">
    <aside class="listing-sidebar">
        <h2>Filter</h2>
        {{ form_start(search_form) }}
            {{ form_widget(search_form) }}

            <button type="submit">Search</button>
        {{ form_end(search_form) }}
    </aside>

    <section class="listing-main">
        <div class="sort-bar">
            Sort by:
            {% for column in enum('App\\Search\\Book\\BookSortableColumn').cases %}
                {% set isActive = criteria.sort?.value == column.value %}
                {% set nextDir  = isActive and criteria.direction == enum('\SortDirection').Ascending ? 'desc' : 'asc' %}

                <a href="{{ path('app_book_index', app.request.query.all|merge({sort: column.value, direction: nextDir})) }}">
                    {{ column.label }}{% if isActive %} {{ criteria.direction == enum('\SortDirection').Ascending ? '↑' : '↓' }}{% endif %}
                </a>
            {% endfor %}
        </div>

        <div class="book-grid">
            {% for book in books %}
                <div class="book-card">
                    <h2>
                        <a href="{{ path('app_book_show', {id: book.id}) }}">
                            {{ book.title }}
                        </a>
                    </h2>
                    <p>
                        {{ book.authors|map(a => a.name)|join(', ') }}
                        &mdash; {{ book.publicationDate|date('Y') }}
                    </p>

                    {% if book.available %}
                        <form method="POST" action="{{ path('app_loan_new', {id: book.id}) }}">
                            <button type="submit" class="btn">Borrow</button>
                        </form>
                    {% else %}
                        <span class="muted">Currently on loan</span>
                    {% endif %}

                    {% if is_granted('book/edit', book) %}
                        <a href="{{ path('admin_book_edit', {id: book.id}) }}" class="btn btn-outline-secondary">
                            Edit
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
