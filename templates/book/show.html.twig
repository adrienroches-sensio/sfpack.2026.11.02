{% extends 'base.html.twig' %}

{% block title "#{book.title} - Community Library" %}

{% block body %}
    <h1>{{ book.title }}</h1>

    <div class="book-meta">
        <span>{{ book.authors|map(author => author.name)|join(', ') }}</span>
        <span>{{ book.language }}</span>
        {% for genre in book.genres %}
            <span class="genre-badge">{{ genre.name|upper }}</span>
        {% endfor %}
    </div>

    <hr>

    <p>{{ book.summary }}</p>

    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary">← Back to all books</a>
{% endblock body %}
